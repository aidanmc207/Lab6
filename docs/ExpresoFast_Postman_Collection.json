        {
          "name": "GET /api/envios/optimizados (ADMIN, OPERADOR, CONDUCTOR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "if (Array.isArray(lista) && lista.length > 0) {",
                  "    pm.collectionVariables.set('envioId', lista[0].id);",
                  "    pm.test('El DTO no expone entidades JPA', () => pm.expect(lista[0]).to.have.property('placaVehiculo'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/envios/optimizados",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios", "optimizados"]
            }

        },
        {
          "name": "POST /api/envios (ADMIN, OPERADOR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const creado = pm.response.json();",
                  "pm.collectionVariables.set('envioId', creado.id);",
                  "pm.test('Nace en PENDIENTE', () => pm.expect(creado.estadoEnvio).to.eql('PENDIENTE'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoRastreo\": \"EXP-7788\",\n  \"direccionDestino\": \"Paraiso, Cartago, 200m sur de la iglesia\",\n  \"pesoKg\": 15.50,\n  \"costo\": 4200.00,\n  \"vehiculoId\": 1,\n  \"conductorId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/envios", "host": ["{{baseUrl}}"], "path": ["api", "envios"] }
          }
        },
        {
          "name": "POST /api/envios con datos invalidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('Detalla el error por campo', () => pm.expect(cuerpo.errores).to.have.property('codigoRastreo'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoRastreo\": \"PAQUETE-1\",\n  \"direccionDestino\": \"\",\n  \"pesoKg\": -3,\n  \"costo\": -100,\n  \"vehiculoId\": 1,\n  \"conductorId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/envios", "host": ["{{baseUrl}}"], "path": ["api", "envios"] },
            "description": "Verifica @Pattern(^EXP-\\d{4}$), @NotBlank y @Positive del EnvioRequestDTO."
          }
        },

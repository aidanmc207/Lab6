          "name": "PATCH transicion invalida (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de transicion', () => pm.expect(pm.response.json().mensaje).to.include('Transici'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"PENDIENTE\",\n  \"observaciones\": \"Intento de regresar un envio ya entregado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/envios/3/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios", "3", "estado"]
            },
            "description": "El envio 3 de las semillas esta ENTREGADO: la regla InvalidStateTransitionException debe rechazar el cambio."
          }
        },

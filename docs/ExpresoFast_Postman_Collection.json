  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "01 Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('Devuelve token', () => pm.expect(cuerpo.token).to.be.a('string').and.not.empty);",
                  "pm.test('Incluye ROLE_ADMIN', () => pm.expect(cuerpo.roles).to.include('ROLE_ADMIN'));",
                  "pm.collectionVariables.set('token', cuerpo.token);",
                  "pm.collectionVariables.set('token_admin', cuerpo.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Endpoint publico. Devuelve el token JWT, el nombre completo, los roles y la fecha de expiracion."
          }
        },
        {
          "name": "02 Login OPERADOR",
          "event": [

                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('token', cuerpo.token);",
                  "pm.collectionVariables.set('token_operador', cuerpo.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"operador1\",\n  \"password\": \"oper123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }

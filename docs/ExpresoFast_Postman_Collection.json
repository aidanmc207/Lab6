            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_operador}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"ENTREGADO\",\n  \"observaciones\": \"El operador no confirma entregas\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/envios/{{envioId}}/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios", "{{envioId}}", "estado"]
            },
            "description": "Verifica el @PreAuthorize que reparte las transiciones entre los roles."
          }
        },

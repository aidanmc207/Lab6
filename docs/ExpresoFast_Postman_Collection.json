                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_operador}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"EN_TRANSITO\",\n  \"observaciones\": \"Paquete cargado en la unidad y en ruta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/envios/{{envioId}}/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios", "{{envioId}}", "estado"]
            },
            "description": "El operador solo puede despachar a EN_TRANSITO. Genera el registro en BitacoraEnvio con el usuario del token."
          }
        },
        {
          "name": "PUT /api/envios/{id}/estado entrega del CONDUCTOR",
          "event": [
